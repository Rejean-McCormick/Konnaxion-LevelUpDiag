{
  "schema": "levelupdiag.config.v2",
  "app_name": "Konnaxion",
  "target_repo_root": "auto",
  "control_dir": ".levelupdiag",
  "toolchain": {
    "required": [
      "python"
    ],
    "optional": [
      "git",
      "node",
      "pnpm",
      "pwsh",
      "kx"
    ]
  },
  "commands": {
    "docs": "",
    "contracts": "",
    "components": "",
    "integrations": "",
    "profiles": "",
    "security": "",
    "offline": "",
    "system": ""
  },
  "env": {},
  "konnaxion": {
    "frontend_dir": "frontend",
    "backend_dir": "backend",
    "capsule_manager_repo": "../Konnaxion_Capsule_Manager",
    "capsule_file": "",
    "local_urls": [
      "http://127.0.0.1:3000",
      "http://127.0.0.1:8000/api/"
    ],
    "commands": {
      "backend_check": [
        "python",
        "manage.py",
        "check"
      ],
      "backend_migrations": [
        "python",
        "manage.py",
        "makemigrations",
        "--check",
        "--dry-run"
      ],
      "backend_smoke": [
        "python",
        "-m",
        "pytest",
        "tests/test_smoke_platform.py",
        "-q"
      ],
      "backend_openapi": [
        "python",
        "-m",
        "pytest",
        "konnaxion/users/tests/api/test_openapi.py",
        "-q"
      ],
      "backend_api_scan": [
        "python",
        "django_api_scanner.py"
      ],
      "frontend_typecheck": [
        "pnpm",
        "exec",
        "tsc",
        "-p",
        "tsconfig.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "frontend_lint": [
        "pnpm",
        "exec",
        "eslint",
        ".",
        "--max-warnings=0"
      ],
      "frontend_jest": [
        "pnpm",
        "exec",
        "jest",
        "--passWithNoTests",
        "--runInBand"
      ],
      "frontend_build": [
        "pnpm",
        "exec",
        "next",
        "build"
      ],
      "frontend_endpoint_scan": [
        "node",
        "scripts/scan-endpoints.mjs"
      ],
      "playwright_smoke": [
        "pnpm",
        "exec",
        "playwright",
        "test",
        "-c",
        "playwright.smoke.config.ts",
        "--reporter=line"
      ],
      "backend_task_tests": [
        "python",
        "-m",
        "pytest",
        "konnaxion/users/tests/test_tasks.py",
        "-q"
      ],
      "jobs_probe": [],
      "django_deploy_check": [
        "python",
        "manage.py",
        "check",
        "--deploy"
      ],
      "capsule_security_tests": [
        "python",
        "-m",
        "pytest",
        "tests/test_security_gate.py",
        "-q"
      ],
      "capsule_manager_tests": [
        "python",
        "-m",
        "pytest",
        "tests/test_instance_states.py",
        "-q"
      ],
      "frontend_full_scan": [],
      "backend_full_tests": [
        "python",
        "-m",
        "pytest",
        "-q"
      ],
      "remote_deep_diagnostic": [],
      "backend_auth_policy": [
        "python",
        "-m",
        "pytest",
        "konnaxion/users/tests/test_auth_policy.py",
        "-q"
      ],
      "backend_worlds_tests": [
        "python",
        "-m",
        "pytest",
        "konnaxion/worlds/tests",
        "-q"
      ],
      "frontend_worlds_tests": [
        "pnpm",
        "exec",
        "jest",
        "lib/__tests__/worlds.test.ts",
        "routes/suites.test.ts",
        "--runInBand"
      ],
      "backend_worlds_isolation_tests": [
        "python",
        "-m",
        "pytest",
        "konnaxion/worlds/tests/test_multiworld_isolation.py",
        "-q"
      ],
      "frontend_i18n_check": [
        "pnpm",
        "run",
        "i18n:check"
      ],
      "i18n_browser_probe": []
    },
    "remote": {
      "enabled": false,
      "domain": "",
      "urls": [],
      "http_timeout_seconds": 10,
      "allow_insecure_tls": false,
      "deep_timeout_seconds": 1800
    },
    "worlds": {
      "architecture_lock": "KX-WORLDS-1",
      "backend_api_base_url": "",
      "http_timeout_seconds": 5,
      "runtime_probe_world_key": "",
      "data_plane_probe_path": "ethikos/"
    },
    "i18n_browser_probe_path": "/ekoh/dashboard?sidebar=ekoh",
    "i18n_browser_probe_timeout_seconds": 180,
    "i18n_browser_probe_required": true
  },
  "execution": {
    "mode": "sequential",
    "default_timeout_seconds": 120,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "retention": "current_only",
    "purge_legacy_evidence": true,
    "protect_tracked_files": true,
    "command_heartbeat_seconds": 15,
    "allow_network": false,
    "allow_target_mutation": false,
    "protect_tracked_restore_paths": []
  },
  "redaction": {
    "enabled": true,
    "replacement": "[REDACTED]"
  }
}
